# --------------------------------------------------------
# [Core Finance Service Environment Configuration]
# --------------------------------------------------------

# 1. 기본 설정
PROJECT_NAME="Core Finance Service"
VERSION="1.0.0"
DEBUG=True
ALLOWED_ORIGINS=["*"]

# 2. 데이터베이스 연결 정보 (타겟: finance_db)
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/finance_db?client_encoding=utf8

# (참고용 변수 - config.py가 얘네를 찾고 있어서 꼭 있어야 해요!)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=finance_db

# 3. Redis 설정 (Core는 0번 DB)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 4. 보안 설정
SECRET_KEY=haebin_core_super_secret_key_v1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 5. 모니터링 & 인프라 설정 (에러 원인! 얘네가 없어서 죽은 거예요)
PROMETHEUS_URL=http://prometheus-service:9090
VPN_GATEWAY_IP=127.0.0.1
KUBE_CONFIG_PATH=""  

# (진짜 DB 상태 체크용 변수 - config.py 필수 항목)
REAL_DB_HOST=127.0.0.1
REAL_DB_PORT=5432
REAL_DB_USER=postgres
REAL_DB_PASSWORD=123456
REAL_DB_NAME=finance_db

# 6. 퀵 메뉴 링크 (config.py 필수 항목)
LINK_GRAFANA_CLUSTER=http://grafana.example.com/d/cluster
LINK_GRAFANA_DB=http://grafana.example.com/d/postgresql
LINK_HUBBLE=http://hubble.example.com
LINK_LOKI=http://grafana.example.com/explore
LINK_ARGOCD=http://argocd.example.com
LINK_RUNBOOK=https://notion.so/my-runbook