# [core-service/.env]

# --------------------------------------------------------
# 1. 기본 설정
# --------------------------------------------------------
PROJECT_NAME=Core Finance Service
VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# --------------------------------------------------------
# 2. 메인 데이터베이스 (SSH 터널링 정보 적용)
# --------------------------------------------------------
# 여기도 'localhost'여야 DB 연결 상태가 초록색으로 뜸!
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=onprem_finance_db

# --------------------------------------------------------
# 3. Redis 설정
# --------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 보안 키
SECRET_KEY=haebin_super_secret_key_core_v1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --------------------------------------------------------
# 4. 모니터링 & 인프라 연결 정보 (링크 완벽 복구!)
# --------------------------------------------------------
# (1) 모니터링용 DB 정보 (위와 동일하게 터널링 사용)
REAL_DB_HOST=127.0.0.1
REAL_DB_PORT=5432
REAL_DB_USER=postgres
REAL_DB_PASSWORD=123456
REAL_DB_NAME=onprem_finance_db

# (2) 기타 인프라 설정
KUBE_CONFIG_PATH=""
PROMETHEUS_URL=http://prometheus-service:9090
VPN_GATEWAY_IP=10.100.0.1

# (3) 퀵 메뉴 (Quick Links) - 지애님 링크 복구 완료! ✨
LINK_GRAFANA_CLUSTER=http://grafana.example.com/d/cluster
LINK_GRAFANA_DB=http://grafana.example.com/d/postgresql
LINK_HUBBLE=http://hubble.example.com
LINK_LOKI=http://grafana.example.com/explore
LINK_ARGOCD=http://argocd.example.com
LINK_RUNBOOK=https://notion.so/my-runbook
