# --------------------------------------------------------
# [Audit Service Environment Configuration]
# --------------------------------------------------------

# 1. 프로젝트 설정
PROJECT_NAME="Audit Service"
VERSION="1.0.0"
DEBUG=True
ALLOWED_ORIGINS=["*"]

# 2. 데이터베이스 연결 정보 (타겟: audit_db)
# 주의: 로컬 SSH 터널링(127.0.0.1)을 사용하므로 localhost 유지!
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/audit_db?client_encoding=utf8

# (참고용 변수)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=audit_db

# 3. Redis 설정 (Audit은 2번 DB 쓸게! 겹치면 안되니까)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=2