# --------------------------------------------------------
# [IAM Auth Service Environment Configuration]
# --------------------------------------------------------

# 1. 프로젝트 설정
PROJECT_NAME="IAM Auth Service"
VERSION="1.0.0"
DEBUG=True
ALLOWED_ORIGINS=["*"]

# 2. 데이터베이스 연결 정보 (타겟: iam_db)
# 주의: 스키마가 'iam'이어도 접속 URL에는 DB 이름인 'iam_db'를 씁니다.
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/iam_db?client_encoding=utf8

# (참고용 변수)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=iam_db

# 3. 보안 및 토큰 설정
SECRET_KEY=haebin_iam_super_secret_key_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 4. Redis 설정 (로그인 세션 저장용 - DB 1번 사용)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1