# [auth-service/.env]

# 1. 기본 설정
PROJECT_NAME=Auth Service
VERSION=1.0.0
SECRET_KEY=haebin_super_secret_key_auth_v1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 2. 데이터베이스 설정 (정석 방법: 터널링 주소 입력!)
# SSH 터널을 뚫었으니까 'localhost'로 접속해야 진짜 DB로 감!
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=onprem_finance_db

# 3. Redis 설정 (로그인 세션용)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
