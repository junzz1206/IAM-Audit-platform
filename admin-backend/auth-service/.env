# --------------------------------------------------------
# [IAM Auth Service Environment Configuration]
# --------------------------------------------------------

# 1. 프로젝트 필수 설정 (이게 없어서 서버가 죽었었음!)
PROJECT_NAME="IAM Auth Service"
VERSION="1.0.0"
DEBUG=True
ALLOWED_ORIGINS=["*"]

# 2. 데이터베이스 연결 정보 (완성형)
# 코드가 조립할 필요 없이, 여기서 완성된 주소를 줘야 가장 확실해!
# 형식: postgresql://아이디:비번@주소:포트/DB이름
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/onprem_finance_db

# (참고용) 개별 정보들도 남겨둠 (혹시 다른 코드에서 쓸까 봐)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=onprem_finance_db

# 3. 보안 및 토큰 설정
SECRET_KEY=haebin_super_secret_key_auth_v1
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 4. Redis 설정
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
