apiVersion: apps/v1
kind: Deployment

metadata:
  name: audit-query-api
  labels:
    app: audit-query-api

spec:
  replicas: {{ audit_query_api_replicas | int }}

  strategy:
    type: Recreate

  selector:
    matchLabels:
      app: audit-query-api

  template:
    metadata:
      labels:
        app: audit-query-api

    spec:
      # --------------------------------------------------
      # ServiceAccount (IAM / RBAC 대비)
      # --------------------------------------------------
      serviceAccountName: audit-query-api

      containers:
        - name: audit-query-api
          image: "{{ audit_query_api_image }}:{{ audit_query_api_image_tag }}"
          imagePullPolicy: IfNotPresent

          ports:
            - containerPort: {{ audit_query_api_port | int }}

          env:
            # --------------------------------------------------
            # API 서비스 포트
            # --------------------------------------------------
            - name: SERVICE_PORT
              value: "{{ audit_query_api_port | string }}"

            # --------------------------------------------------
            # audit-reader 내부 접근 URL
            # --------------------------------------------------
            - name: AUDIT_READER_URL
              value: "http://{{ audit_query_api_reader_host }}:{{ audit_query_api_reader_port }}"

            # --------------------------------------------------
            # IAM 토큰 검증 URL
            # --------------------------------------------------
            - name: IAM_VALIDATE_URL
              value: "{{ iam_validate_url }}"

