# ==========================================================
# PostgreSQL Client Authentication Configuration File
# Managed by Ansible (PostgreSQL role)
# ==========================================================
#
# ⚠️ 수동 수정 금지
# 모든 변경은 Ansible 템플릿(pg_hba.conf.j2)을 통해서만 수행
#

# ----------------------------------------------------------
# TYPE    DATABASE        USER            ADDRESS                 METHOD
# ----------------------------------------------------------

# ----------------------------------------------------------
# Local Unix socket connections (서버 내부 관리용)
# ----------------------------------------------------------
local   all             all                                     peer
# postgres OS 계정 ↔ postgres DB 계정
# 서버 내부 유지보수/관리 작업 전용


# ----------------------------------------------------------
# IPv4 loopback (TCP, same host)
# ----------------------------------------------------------
host    all             all             127.0.0.1/32            scram-sha-256
# 동일 서버에서 TCP/IP 접속


# ----------------------------------------------------------
# AWS VPC Node Network (NON-SSL)
# ----------------------------------------------------------
hostnossl all            all             172.31.22.0/20         scram-sha-256
# EC2 / Kubernetes Node Private Network
# VPC CIDR 기준
# SSL 미사용


# ----------------------------------------------------------
# Kubernetes Pod Network (NON-SSL)
# ----------------------------------------------------------
hostnossl all            all             172.16.0.0/16           scram-sha-256
# Kubernetes Pod CIDR (Calico)
# 초기 기동 안정화 목적 (추후 축소 예정)


# ----------------------------------------------------------
# (선택) Kubernetes Network (SSL)
# ----------------------------------------------------------
# hostssl  all            all             172.31.16.0/20         scram-sha-256
# hostssl  all            all             172.16.0.0/16           scram-sha-256
# SSL 도입 시 활성화


# ----------------------------------------------------------
# Replication (현재 미사용)
# ----------------------------------------------------------
# local   replication     all                                     peer
# host    replication     all             127.0.0.1/32            scram-sha-256
# hostnossl replication  all             172.31.16.0/20         scram-sha-256
# hostnossl replication  all             172.16.0.0/16           scram-sha-256


# ----------------------------------------------------------
# IPv6 (환경 미사용 → 명시적 차단)
# ----------------------------------------------------------
# host    all             all             ::1/128                 reject
# host    replication     all             ::1/128                 reject

